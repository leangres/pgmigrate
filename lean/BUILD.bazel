load("@rules_lean//lean:lean.bzl", "lean_library", "lean_olean_archive", "lean_test")

# `Pg.Migrate` — the migration layer. Today this is `Fold` alone; the provable
# migration work builds here.
#
# `Fold` folds a parsed DDL stream into a `Pg.Catalog.Snapshot`. It is TOTAL and
# deliberately reproduces the quirks of a C tool it replaced — `resolveType`
# falling back to 2249, `resolveBareColumn` ignoring the FROM map, `foldAlterTable`
# silently skipping a missing table. It carries a byte-equivalence claim against
# that tool over a 1,384-statement production schema, so it must not be "fixed":
# the validating transition function (`step`, with real preconditions and an error
# type) is written BESIDE it, and the disagreements between the two are findings to
# triage rather than bugs in either.
#
# Why the file moved from `Pg/Catalog/Fold.lean` to `Pg/Migrate/Fold.lean`: it is
# the only catalog module that reaches outside `Pg.Catalog` (it imports
# `Pg.Query.Top`), so it cannot live in @pgcatalog without dragging the parse tree
# in. And it could not keep its old PATH here either — @pgcatalog publishes oleans
# rooted at `Pg/Catalog/`, so a second archive claiming that same root would
# overlap on unpack.
#
# The `namespace Pg.Catalog` INSIDE the file is unchanged, deliberately. Module
# path and namespace are independent in Lean, so `Snapshot.ofTopParseResult` and
# friends still resolve exactly as before for anyone who had `open Pg.Catalog` —
# only the import line moves. Renaming the namespace too is a later, separate
# decision.
lean_library(
    name = "pgmigrate",
    srcs = [
        "Pg/Migrate/Fold.lean",
        "Pg/Migrate/Step.lean",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pgast//lean:pgast",
        "@pgcatalog//lean:pgcatalog",
        "@pgquery//lean:pgquery",
    ],
)

lean_olean_archive(
    name = "pgmigrate_oleans",
    library = ":pgmigrate",
    visibility = ["//visibility:public"],
)

# The transition's preconditions — most of these assert a REFUSAL, because a
# transition that accepts everything is what Fold already is.
lean_test(
    name = "step_test",
    srcs = ["Pg/Migrate/StepTest.lean"],
    entry = "Pg/Migrate/StepTest.lean",
    visibility = ["//visibility:public"],
    deps = [":pgmigrate"],
)

lean_test(
    name = "fold_test",
    srcs = ["Pg/Migrate/FoldTest.lean"],
    entry = "Pg/Migrate/FoldTest.lean",
    visibility = ["//visibility:public"],
    deps = [":pgmigrate"],
)

# End-to-end: real SQL decoded by @pgquery's C tool into typed Lean, then folded.
# `SmokeFixtureTyped.lean` is GENERATED by that tool, so this test exercises the
# decoder and the fold together rather than either in isolation.
lean_test(
    name = "fold_pipeline_test",
    srcs = [
        "Pg/Migrate/FoldPipelineTest.lean",
        "@pgquery//tools/pgpb_to_lean_ast:SmokeFixtureTyped.lean",
    ],
    entry = "Pg/Migrate/FoldPipelineTest.lean",
    visibility = ["//visibility:public"],
    deps = [":pgmigrate"],
)
